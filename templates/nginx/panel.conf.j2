server {
    listen 127.0.0.1:{{ xui_panel_proxy_port }} ssl http2 proxy_protocol;
    server_name {{ xui_panel_domain }};

    absolute_redirect off;
    real_ip_header proxy_protocol;
    set_real_ip_from 127.0.0.1;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate {{ xui_panel_certificate_dir }}/fullchain.pem;
    ssl_certificate_key {{ xui_panel_certificate_dir }}/privkey.pem;

    location = /{{ xui_panel_path }} {
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection $xui_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:{{ xui_panel_port }};
    }

    location ^~ /{{ xui_panel_path }}/ {
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection $xui_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:{{ xui_panel_port }};
    }

    include /etc/nginx/snippets/3x-ui-includes.conf;
}
